{
  "url": "https://bxure-v3.ben.com/Pre/log",
  "timezone": "Asia/Shanghai",
  "profile": "codex",
  "dataDir": ".bxure",
  "headless": false,
  "browserChannel": "chromium",
  "resultLimit": null,
  "maxQueries": 32,
  "minSliceSeconds": 1,
  "maxFileBytes": 20971520,
  "timeoutMs": 30000,
  "encoding": "utf-8",
  "selectors": {
    "instanceItems": ".el-tree-node__label",
    "startTime": ".el-date-editor .el-range-input >> nth=0",
    "endTime": ".el-date-editor .el-range-input >> nth=1",
    "pickerStartDate": ".el-picker__popper:visible input[placeholder=\"开始日期\"]",
    "pickerStartTime": ".el-picker__popper:visible input[placeholder=\"开始时间\"]",
    "pickerEndDate": ".el-picker__popper:visible input[placeholder=\"结束日期\"]",
    "pickerEndTime": ".el-picker__popper:visible input[placeholder=\"结束时间\"]",
    "pickerConfirm": ".el-picker__popper:visible .el-picker-panel__link-btn:has-text(\"确定\")",
    "keyword": "input[placeholder=\"搜索关键字\"]",
    "searchButton": "button:has-text('搜索')",
    "resultRows": ".el-table__body-wrapper tbody tr",
    "cells": "td",
    "loading": ".el-loading-mask:visible",
    "empty": ".el-table__empty-text",
    "limitIndicator": "",
    "previewButton": "text=预览",
    "downloadButton": "text=下载",
    "previewContent": ".log-preview-drawer:visible .view-lines",
    "previewClose": ".log-preview-drawer:visible .el-drawer__close-btn"
  }
}
